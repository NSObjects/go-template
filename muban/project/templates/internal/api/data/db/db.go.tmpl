 */

package db

import (
	"context"
	"fmt"

	"github.com/IBM/sarama"
	configs "github.com/NSObjects/go-kit/config"
	kitdb "github.com/NSObjects/go-kit/db"
	"{{.ModulePath}}/internal/api/data/query"
	"go.uber.org/fx"
	"gorm.io/gorm"
)

// Module 提供数据层的 Fx 依赖注入
var Module = fx.Options(
	fx.Provide(NewManager),
	fx.Provide(NewDB),
	fx.Provide(NewQuery),
	fx.Provide(NewKafkaProducer),
)

// Manager 扩展 go-kit/db.Manager，添加业务特定组件
type Manager struct {
	*kitdb.Manager
	Kafka sarama.SyncProducer
}

// NewManager 创建数据管理器
// 使用 go-kit/db.Manager 处理 Database/Redis/MongoDB
// Kafka 单独处理（go-kit 暂不支持）
func NewManager(lc fx.Lifecycle, cfg configs.Config) (*Manager, error) {
	ctx := context.Background()

	// 使用 go-kit 创建核心管理器
	kitMgr, err := kitdb.NewManager(ctx, cfg)
	if err != nil {
		return nil, fmt.Errorf("create db manager: %w", err)
	}

	mgr := &Manager{Manager: kitMgr}

	// 注册 GORM 业务回调（可选）
	if kitMgr.DB != nil {
		registerCallbacks(kitMgr.DB)
	}

	// 初始化 Kafka（可选）
	if len(cfg.Kafka.Brokers) > 0 {
		producer, err := newKafkaSyncProducer(cfg.Kafka)
		if err != nil {
			return nil, fmt.Errorf("create kafka producer: %w", err)
		}
		mgr.Kafka = producer
	}

	// 注册生命周期
	lc.Append(fx.Hook{
		OnStart: func(ctx context.Context) error {
			return kitMgr.Start(ctx)
		},
		OnStop: func(ctx context.Context) error {
			var errs []error
			if mgr.Kafka != nil {
				if err := mgr.Kafka.Close(); err != nil {
					errs = append(errs, fmt.Errorf("kafka close: %w", err))
				}
			}
			if err := kitMgr.Stop(ctx); err != nil {
				errs = append(errs, err)
			}
			if len(errs) > 0 {
				return errs[0]
			}
			return nil
		},
	})

	return mgr, nil
}

// NewDB 提供 GORM 数据库实例（Fx 注入用）
func NewDB(mgr *Manager) *gorm.DB {
	if mgr == nil {
		return nil
	}
	return mgr.DB
}

// NewQuery 提供 gen 生成的类型安全查询接口（Fx 注入用）
func NewQuery(db *gorm.DB) *query.Query {
	if db == nil {
		return nil
	}
	return query.Use(db)
}

// NewKafkaProducer 提供 Kafka 生产者（Fx 注入用）
func NewKafkaProducer(mgr *Manager) sarama.SyncProducer {
	if mgr == nil {
		return nil
	}
	return mgr.Kafka
}

// ========== 内部辅助函数 ==========

// registerCallbacks 注册 GORM 业务回调
func registerCallbacks(db *gorm.DB) {
	// 示例：审计日志回调（按需启用）
	// _ = db.Callback().Create().After("gorm:create").Register("audit:after_create", auditCallback)
}

// newKafkaSyncProducer 创建 Kafka 同步生产者
func newKafkaSyncProducer(cfg configs.KafkaConfig) (sarama.SyncProducer, error) {
	sc := sarama.NewConfig()
	sc.ClientID = cfg.ClientID
	sc.Producer.RequiredAcks = sarama.WaitForAll
	sc.Producer.Retry.Max = 3
	sc.Producer.Return.Successes = true
	return sarama.NewSyncProducer(cfg.Brokers, sc)
}
