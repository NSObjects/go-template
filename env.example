# 环境变量配置示例
# 复制此文件为 .env 并修改相应值

# 系统配置
RUN_ENVIRONMENT=dev
ECHOADMIN_SYSTEM_PORT=:9322
ECHOADMIN_SYSTEM_LEVEL=1
ECHOADMIN_SYSTEM_ENV=dev

# GORM 数据库能力提供者；默认不配置时不启用数据库能力。
# 业务适配器需要 GORM 时设置为 mysql，并同时启用和配置 ECHOADMIN_MYSQL_*。
ECHOADMIN_CAPABILITIES_PROVIDERS_DATABASE_GORM=

# MySQL 能力配置
ECHOADMIN_MYSQL_ENABLED=false
ECHOADMIN_MYSQL_HOST=127.0.0.1
ECHOADMIN_MYSQL_PORT=3306
ECHOADMIN_MYSQL_DATABASE=test
ECHOADMIN_MYSQL_USER=root
ECHOADMIN_MYSQL_PASSWORD=12345678
ECHOADMIN_MYSQL_MAX_IDLE_CONNS=20
ECHOADMIN_MYSQL_MAX_OPEN_CONNS=20

# Redis配置
ECHOADMIN_REDIS_HOST=127.0.0.1
ECHOADMIN_REDIS_PORT=6379
ECHOADMIN_REDIS_PASSWORD=
ECHOADMIN_REDIS_DATABASE=0

# JWT配置
ECHOADMIN_JWT_SECRET=tn)M^P<j,/6$Gr/Wrs
ECHOADMIN_JWT_EXPIRE=3600

# 日志配置
ECHOADMIN_LOG_LEVEL=debug
ECHOADMIN_LOG_FORMAT=color

# CORS配置
ECHOADMIN_CORS_ALLOW_ORIGINS=*
ECHOADMIN_CORS_ALLOW_HEADERS=Origin,Content-Type,Accept
ECHOADMIN_CORS_ALLOW_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE
ECHOADMIN_CORS_ALLOW_CREDENTIALS=true
